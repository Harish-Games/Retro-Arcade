<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Joust (1982) - 10/10 Arcade Replica</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            user-select: none;
        }
        body {
            background: #0a0512;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            font-family: 'Courier New', monospace;
            touch-action: none;
        }
        .game-wrapper {
            background: linear-gradient(145deg, #1f113a, #0a0512);
            padding: 20px;
            border-radius: 32px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.9), inset 0 0 40px rgba(100, 60, 180, 0.15);
        }
        canvas {
            display: block;
            width: 100%;
            height: auto;
            max-width: 800px;
            border-radius: 16px;
            background: #0b0b1a;
            cursor: pointer;
            box-shadow: inset 0 0 50px rgba(30, 10, 60, 0.8);
            aspect-ratio: 800 / 600;
        }
        .hud {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 14px;
            color: #f0e6b0;
            font-weight: bold;
            font-size: 1.2rem;
            text-shadow: 0 0 12px rgba(255, 200, 80, 0.3);
            padding: 0 8px;
            flex-wrap: wrap;
            gap: 8px;
        }
        .hud div {
            background: rgba(0, 0, 0, 0.6);
            padding: 4px 16px;
            border-radius: 40px;
            border: 1px solid rgba(255, 200, 80, 0.15);
            backdrop-filter: blur(2px);
        }
        .hud button {
            background: #f0c040;
            color: #1a0a2e;
            border: none;
            padding: 6px 24px;
            border-radius: 40px;
            font-weight: bold;
            font-size: 1rem;
            font-family: 'Courier New', monospace;
            cursor: pointer;
            box-shadow: 0 4px 0 #8a6a1a;
            transition: 0.05s linear;
            touch-action: manipulation;
        }
        .hud button:active {
            transform: translateY(4px);
            box-shadow: none;
        }
        .hint {
            color: #665588;
            font-size: 0.75rem;
            text-align: center;
            margin-top: 8px;
            letter-spacing: 1px;
        }
        @media (max-width: 500px) {
            .game-wrapper { padding: 10px; }
            .hud { font-size: 0.9rem; justify-content: center; }
        }
    </style>
</head>
<body>
<div class="game-wrapper">
    <canvas id="gameCanvas" width="800" height="600"></canvas>
    <div class="hud">
        <div>❤️ <span id="livesDisplay">3</span></div>
        <div>🏆 <span id="scoreDisplay">0</span></div>
        <div>⚔️ Wave <span id="waveDisplay">1</span></div>
        <div>🐦 <span id="enemyCount">0</span></div>
        <button id="restartBtn">↻ Restart</button>
    </div>
    <div class="hint">← ↑ → &nbsp;|&nbsp; A W D &nbsp;|&nbsp; Space / Tap to Flap</div>
</div>

<script>
    (function() {
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        const livesSpan = document.getElementById('livesDisplay');
        const scoreSpan = document.getElementById('scoreDisplay');
        const waveSpan = document.getElementById('waveDisplay');
        const enemyCountSpan = document.getElementById('enemyCount');

        const W = 800,
            H = 600;
        canvas.width = W;
        canvas.height = H;

        // ----- CONSTANTS -----
        const GRAVITY = 0.28;
        const FLAP_FORCE = -5.0;
        const MAX_SPEED = 5.0;
        const GROUND_Y = 550;
        const PLAYER_RADIUS = 18;

        // ----- PLATFORMS (x, y, width, height) -----
        const PLATFORMS = [
            { x: 80, y: 440, w: 130, h: 14 },
            { x: 320, y: 350, w: 160, h: 14 },
            { x: 580, y: 440, w: 130, h: 14 },
            { x: 210, y: 240, w: 120, h: 14 },
            { x: 500, y: 260, w: 110, h: 14 }
        ];

        // ----- GAME STATE -----
        let player = { x: 150, y: 350, vx: 0, vy: 0, onGround: false };
        let enemies = [];
        let eggs = [];
        let particles = [];
        let floatingTexts = [];
        let troll = { active: false, y: GROUND_Y, targetY: GROUND_Y, timer: 0, handX: 0 };
        let pterodactyl = { active: false, x: 0, y: 0, vx: 0, vy: 0, timer: 0, hit: false };

        let score = 0;
        let lives = 3;
        let wave = 1;
        let enemiesPerWave = 3;
        let enemiesSpawned = 0;
        let enemiesDefeated = 0;
        let gameOver = false;
        let frame = 0;
        let flapping = false;
        let waveClearTimer = 0;
        let pterodactylSpawnTimer = 0;
        let gameStarted = false;

        // Input
        const keys = { left: false, right: false, flap: false };

        // ----- HELPER FUNCTIONS -----
        function updateHUD() {
            livesSpan.textContent = lives;
            scoreSpan.textContent = score;
            waveSpan.textContent = wave;
            enemyCountSpan.textContent = enemies.length;
        }

        function rand(min, max) { return Math.random() * (max - min) + min; }

        function randInt(min, max) { return Math.floor(rand(min, max + 1)); }

        function dist(a, b) { return Math.hypot(a.x - b.x, a.y - b.y); }

        function rectCircleCollide(rx, ry, rw, rh, cx, cy, cr) {
            const closestX = Math.max(rx, Math.min(cx, rx + rw));
            const closestY = Math.max(ry, Math.min(cy, ry + rh));
            const dx = cx - closestX;
            const dy = cy - closestY;
            return (dx * dx + dy * dy) < (cr * cr);
        }

        // ----- SPAWN FUNCTIONS -----
        function spawnEnemy(type) {
            const side = Math.random() < 0.5 ? -1 : 1;
            const x = side === -1 ? -30 : W + 30;
            const y = 80 + Math.random() * 250;
            let baseSpeed = 0.8 + wave * 0.12;
            let flapFreq = 20;
            let name = 'bounder';
            let color = '#cc4444';
            let radius = 16;

            if (type === 'hunter') {
                baseSpeed *= 1.2;
                flapFreq = 15;
                name = 'hunter';
                color = '#ddddcc';
            } else if (type === 'shadow') {
                baseSpeed *= 1.8;
                flapFreq = 10;
                name = 'shadow';
                color = '#4488dd';
                radius = 17;
            }

            return {
                x: x,
                y: y,
                vx: baseSpeed * side,
                vy: 0,
                radius: radius,
                flapTimer: randInt(5, flapFreq),
                flapFreq: flapFreq,
                type: name,
                color: color,
                stunned: 0,
                state: 'chase',
                dirChangeTimer: randInt(30, 90),
                onGround: false,
                groundedPlatform: null
            };
        }

        function spawnWave() {
            enemiesDefeated = 0;
            enemiesSpawned = 0;
            pterodactyl.active = false;
            pterodactylSpawnTimer = 0;
            waveClearTimer = 0;

            const count = Math.min(3 + wave * 2, 14);
            enemiesPerWave = count;
            let types = ['bounder', 'bounder'];
            if (wave >= 2) types.push('hunter');
            if (wave >= 3) types.push('hunter');
            if (wave >= 4) types.push('shadow');
            if (wave >= 5) types.push('shadow', 'shadow');

            for (let i = 0; i < count; i++) {
                setTimeout(() => {
                    if (gameOver) return;
                    const type = types[randInt(0, types.length - 1)];
                    enemies.push(spawnEnemy(type));
                    enemiesSpawned++;
                }, i * 350 + 300);
            }
            updateHUD();
        }

        function spawnEgg(x, y) {
            eggs.push({
                x: x,
                y: y,
                vy: -2.5,
                lifetime: 0,
                maxLifetime: 200,
                radius: 9,
                onPlatform: false
            });
        }

        function spawnParticles(x, y, color, count = 25) {
            for (let i = 0; i < count; i++) {
                const angle = Math.random() * Math.PI * 2;
                const speed = 1 + Math.random() * 5;
                particles.push({
                    x: x,
                    y: y,
                    vx: Math.cos(angle) * speed,
                    vy: Math.sin(angle) * speed - 1,
                    life: 25 + Math.random() * 35,
                    maxLife: 60,
                    radius: 2 + Math.random() * 5,
                    color: color
                });
            }
        }

        function spawnFloatingText(x, y, text, color = '#ffdd77') {
            floatingTexts.push({ x, y, text, color, life: 50, vy: -1.5 });
        }

        // ----- RESET -----
        function resetGame() {
            player = { x: 150, y: 350, vx: 0, vy: 0, onGround: false };
            enemies = [];
            eggs = [];
            particles = [];
            floatingTexts = [];
            troll = { active: false, y: GROUND_Y, targetY: GROUND_Y, timer: 0, handX: 0 };
            pterodactyl = { active: false, x: 0, y: 0, vx: 0, vy: 0, timer: 0, hit: false };
            score = 0;
            lives = 3;
            wave = 1;
            enemiesPerWave = 3;
            enemiesSpawned = 0;
            enemiesDefeated = 0;
            gameOver = false;
            frame = 0;
            flapping = false;
            waveClearTimer = 0;
            pterodactylSpawnTimer = 0;
            gameStarted = true;
            updateHUD();
            spawnWave();
        }

        // ----- INPUT -----
        document.addEventListener('keydown', (e) => {
            const key = e.key;
            if (key === 'ArrowLeft' || key === 'a' || key === 'A') keys.left = true;
            if (key === 'ArrowRight' || key === 'd' || key === 'D') keys.right = true;
            if (key === 'ArrowUp' || key === 'w' || key === 'W' || key === ' ') {
                e.preventDefault();
                keys.flap = true;
                if (!gameOver && gameStarted) flapping = true;
            }
            if (key === 'r' || key === 'R') resetGame();
        });
        document.addEventListener('keyup', (e) => {
            const key = e.key;
            if (key === 'ArrowLeft' || key === 'a' || key === 'A') keys.left = false;
            if (key === 'ArrowRight' || key === 'd' || key === 'D') keys.right = false;
            if (key === 'ArrowUp' || key === 'w' || key === 'W' || key === ' ') {
                e.preventDefault();
                keys.flap = false;
                flapping = false;
            }
        });

        function handleTap(e) {
            e.preventDefault();
            if (!gameStarted || gameOver) { resetGame(); return; }
            flapping = true;
            setTimeout(() => { flapping = false; }, 80);
        }
        canvas.addEventListener('mousedown', handleTap);
        canvas.addEventListener('touchstart', handleTap, { passive: false });
        document.getElementById('restartBtn').addEventListener('click', resetGame);

        // ----- UPDATE -----
        function update() {
            if (gameOver || !gameStarted) return;
            frame++;

            // --- Player Physics ---
            if (flapping || keys.flap) {
                player.vy = FLAP_FORCE;
                player.onGround = false;
            }
            player.vy += GRAVITY;
            if (player.vy > 7) player.vy = 7;

            if (keys.left) player.vx = -MAX_SPEED;
            else if (keys.right) player.vx = MAX_SPEED;
            else player.vx *= 0.92;

            player.x += player.vx;
            player.y += player.vy;

            // Player wrap horizontal
            if (player.x < -20) player.x = W + 20;
            if (player.x > W + 20) player.x = -20;

            // Player platform collision
            player.onGround = false;
            for (let p of PLATFORMS) {
                if (player.vy >= 0 &&
                    player.x > p.x - PLAYER_RADIUS && player.x < p.x + p.w + PLAYER_RADIUS &&
                    player.y + PLAYER_RADIUS >= p.y && player.y + PLAYER_RADIUS <= p.y + p.h + 8) {
                    player.y = p.y - PLAYER_RADIUS;
                    player.vy = 0;
                    player.onGround = true;
                    break;
                }
            }

            // Ceiling / Ground (Lava)
            if (player.y < PLAYER_RADIUS) { player.y = PLAYER_RADIUS;
                player.vy = 0; }
            if (player.y > GROUND_Y - PLAYER_RADIUS) {
                // Hit lava!
                spawnParticles(player.x, GROUND_Y, '#ff4422', 30);
                lives--;
                updateHUD();
                if (lives <= 0) { gameOver = true; return; }
                player.x = 150;
                player.y = 300;
                player.vx = 0;
                player.vy = 0;
                // Stun nearby enemies
                for (let e of enemies) {
                    if (dist(player, e) < 150) e.stunned = 25;
                }
            }

            // --- TROLL LOGIC ---
            troll.timer--;
            let targetNearLava = false;
            // Check if player or enemies are near the lava
            if (player.y > GROUND_Y - 80) targetNearLava = true;
            for (let e of enemies) {
                if (e.y > GROUND_Y - 80 && e.stunned === 0) targetNearLava = true;
            }
            if (targetNearLava && troll.timer <= 0 && !troll.active) {
                troll.active = true;
                troll.y = GROUND_Y;
                troll.targetY = GROUND_Y - rand(60, 140);
                troll.handX = (player.x + rand(-60, 60));
                troll.timer = randInt(60, 180);
            }
            if (troll.active) {
                troll.y += (troll.targetY - troll.y) * 0.06;
                if (Math.abs(troll.y - troll.targetY) < 2) {
                    troll.active = false;
                    troll.y = GROUND_Y;
                    troll.timer = randInt(120, 300);
                }
                // Troll grabs player
                if (Math.abs(player.x - troll.handX) < 40 && Math.abs(player.y - troll.y) < 40) {
                    spawnParticles(player.x, player.y, '#ff2222', 30);
                    lives--;
                    updateHUD();
                    if (lives <= 0) { gameOver = true; return; }
                    player.x = 150;
                    player.y = 300;
                    player.vx = 0;
                    player.vy = 0;
                    troll.active = false;
                    troll.y = GROUND_Y;
                    troll.timer = 60;
                }
                // Troll grabs enemies
                for (let i = enemies.length - 1; i >= 0; i--) {
                    const e = enemies[i];
                    if (Math.abs(e.x - troll.handX) < 35 && Math.abs(e.y - troll.y) < 35 && e.stunned === 0) {
                        spawnParticles(e.x, e.y, '#ff8844', 20);
                        spawnFloatingText(e.x, e.y - 20, '+50', '#ffaa44');
                        score += 50;
                        updateHUD();
                        enemies.splice(i, 1);
                    }
                }
            }

            // --- ENEMIES UPDATE ---
            for (let i = enemies.length - 1; i >= 0; i--) {
                const e = enemies[i];
                if (e.stunned > 0) {
                    e.stunned--;
                    e.vy += GRAVITY * 0.6;
                    e.y += e.vy;
                    // Stunned enemies can still land on platforms
                    for (let p of PLATFORMS) {
                        if (e.vy >= 0 && e.x > p.x - e.radius && e.x < p.x + p.w + e.radius &&
                            e.y + e.radius >= p.y && e.y + e.radius <= p.y + p.h + 8) {
                            e.y = p.y - e.radius;
                            e.vy = 0;
                            break;
                        }
                    }
                    if (e.y > GROUND_Y - e.radius) {
                        spawnParticles(e.x, GROUND_Y, '#ff8844', 15);
                        enemies.splice(i, 1);
                        continue;
                    }
                    continue;
                }

                // Flap logic
                e.flapTimer--;
                if (e.flapTimer <= 0) {
                    e.vy = -3.5 - (wave * 0.1) - (e.type === 'shadow' ? 1.0 : 0);
                    e.flapTimer = e.flapFreq + randInt(-3, 6);
                }
                e.vy += GRAVITY * 0.75;
                if (e.vy > 5) e.vy = 5;

                // AI: Horizontal movement
                const dx = player.x - e.x;
                const dy = player.y - e.y;

                if (e.type === 'bounder') {
                    e.dirChangeTimer--;
                    if (e.dirChangeTimer <= 0) {
                        e.vx = (0.8 + wave * 0.1) * (Math.random() < 0.5 ? 1 : -1);
                        e.dirChangeTimer = randInt(40, 120);
                    }
                    // Slight homing
                    e.vx += Math.sign(dx) * 0.02;
                } else { // Hunters and Shadows aggressively chase
                    let targetSpeed = (1.2 + wave * 0.1) * Math.sign(dx);
                    if (e.type === 'shadow') targetSpeed *= 1.5;
                    e.vx += (targetSpeed - e.vx) * 0.025;
                    // Try to get ABOVE the player
                    if (dy < -20) { // player is above
                        e.vy -= 0.08;
                    } else if (dy > 20) { // player is below
                        e.vy += 0.06;
                    }
                }

                // Clamp horizontal speed
                let maxVx = 2.5 + wave * 0.15;
                if (e.type === 'shadow') maxVx *= 1.8;
                e.vx = Math.max(-maxVx, Math.min(maxVx, e.vx));

                e.x += e.vx;
                e.y += e.vy;

                // Enemies BOUNCE off walls (authentic!)
                if (e.x < e.radius) { e.x = e.radius;
                    e.vx = Math.abs(e.vx); }
                if (e.x > W - e.radius) { e.x = W - e.radius;
                    e.vx = -Math.abs(e.vx); }

                // Enemy platform collision
                e.onGround = false;
                for (let p of PLATFORMS) {
                    if (e.vy >= 0 && e.x > p.x - e.radius && e.x < p.x + p.w + e.radius &&
                        e.y + e.radius >= p.y && e.y + e.radius <= p.y + p.h + 8) {
                        e.y = p.y - e.radius;
                        e.vy = 0;
                        e.onGround = true;
                        break;
                    }
                }

                // Enemy falls into lava
                if (e.y > GROUND_Y - e.radius) {
                    spawnParticles(e.x, GROUND_Y, '#ff6622', 15);
                    enemies.splice(i, 1);
                    continue;
                }
            }

            // --- PLAYER vs ENEMY (JOUSTING) ---
            for (let i = enemies.length - 1; i >= 0; i--) {
                const e = enemies[i];
                if (e.stunned > 0) continue;
                const d = dist(player, e);
                const threshold = PLAYER_RADIUS + e.radius - 5;

                if (d < threshold) {
                    // High ground wins!
                    if (player.y < e.y - 10) {
                        // PLAYER WINS!
                        spawnParticles(e.x, e.y, '#ffaa44', 30);
                        spawnEgg(e.x, e.y);
                        spawnFloatingText(e.x, e.y - 30, '+10', '#ffdd77');
                        score += 10 + wave;
                        enemiesDefeated++;
                        updateHUD();
                        enemies.splice(i, 1);
                        // Maybe spawn a replacement if wave not over
                        if (enemies.length < enemiesPerWave + 3 && enemiesSpawned < enemiesPerWave + 5) {
                            setTimeout(() => { if (!gameOver && !pterodactyl.active) spawnEnemy('bounder'); }, 700);
                        }
                    } else if (e.y < player.y - 10) {
                        // ENEMY WINS!
                        spawnParticles(player.x, player.y, '#ff4444', 25);
                        lives--;
                        updateHUD();
                        if (lives <= 0) { gameOver = true; return; }
                        player.x = 150;
                        player.y = 300;
                        player.vx = 0;
                        player.vy = 0;
                        for (let e2 of enemies) {
                            if (dist(player, e2) < 130) e2.stunned = 30;
                        }
                    } else {
                        // Side collision - bounce apart
                        e.vx *= -1.2;
                        player.vx *= -1.2;
                    }
                }
            }

            // --- EGGS ---
            for (let i = eggs.length - 1; i >= 0; i--) {
                const egg = eggs[i];
                egg.vy += 0.12;
                egg.y += egg.vy;
                egg.lifetime++;

                // Check platform collision for eggs
                let landed = false;
                for (let p of PLATFORMS) {
                    if (egg.vy >= 0 && egg.x > p.x - egg.radius && egg.x < p.x + p.w + egg.radius &&
                        egg.y + egg.radius >= p.y && egg.y + egg.radius <= p.y + p.h + 10) {
                        egg.y = p.y - egg.radius;
                        egg.vy = 0;
                        landed = true;
                        break;
                    }
                }

                // If egg hits ground (lava) or platform -> HATCH!
                if (egg.y > GROUND_Y - egg.radius || landed) {
                    spawnParticles(egg.x, egg.y, '#55cc55', 20);
                    // Hatch into a faster Shadow Lord
                    const newEnemy = {
                        x: egg.x,
                        y: egg.y - 40,
                        vx: (Math.random() < 0.5 ? 1 : -1) * (2 + wave * 0.2),
                        vy: -2,
                        radius: 17,
                        flapTimer: 5,
                        flapFreq: 10,
                        type: 'shadow',
                        color: '#4488dd',
                        stunned: 0,
                        state: 'chase',
                        dirChangeTimer: 30,
                        onGround: false
                    };
                    enemies.push(newEnemy);
                    spawnFloatingText(egg.x, egg.y - 40, 'HATCH!', '#ff4444');
                    eggs.splice(i, 1);
                    continue;
                }

                // Player collects egg
                if (dist(player, egg) < PLAYER_RADIUS + egg.radius) {
                    spawnParticles(egg.x, egg.y, '#ffdd77', 15);
                    spawnFloatingText(egg.x, egg.y - 20, '+5', '#ffdd77');
                    score += 5;
                    updateHUD();
                    eggs.splice(i, 1);
                    continue;
                }

                if (egg.lifetime > egg.maxLifetime) {
                    eggs.splice(i, 1);
                }
            }

            // --- PTERODACTYL ---
            if (enemies.length > 0) {
                pterodactylSpawnTimer++;
                // Spawn after ~15 seconds if wave isn't cleared
                if (pterodactylSpawnTimer > 900 && !pterodactyl.active) {
                    pterodactyl.active = true;
                    pterodactyl.x = Math.random() < 0.5 ? -40 : W + 40;
                    pterodactyl.y = 80 + Math.random() * 200;
                    pterodactyl.vx = (pterodactyl.x < 0 ? 1 : -1) * (2.5 + wave * 0.2);
                    pterodactyl.vy = (Math.random() - 0.5) * 1.5;
                    pterodactyl.hit = false;
                    spawnFloatingText(W / 2 - 60, 80, '🦅 PTERODACTYL!', '#ff6666');
                }
            }

            if (pterodactyl.active) {
                pterodactyl.x += pterodactyl.vx;
                pterodactyl.y += pterodactyl.vy;
                if (pterodactyl.y < 30 || pterodactyl.y > GROUND_Y - 80) pterodactyl.vy *= -1;
                if (pterodactyl.x < -100 || pterodactyl.x > W + 100) {
                    pterodactyl.active = false;
                }

                // Player vs Pterodactyl
                const dPtero = dist(player, { x: pterodactyl.x, y: pterodactyl.y });
                if (dPtero < PLAYER_RADIUS + 28) {
                    if (player.y < pterodactyl.y - 15) {
                        // Killed Pterodactyl!
                        spawnParticles(pterodactyl.x, pterodactyl.y, '#ffaa00', 50);
                        spawnFloatingText(pterodactyl.x, pterodactyl.y - 40, '+250 BONUS!', '#ffdd00');
                        score += 250;
                        updateHUD();
                        pterodactyl.active = false;
                        // Stun all enemies
                        for (let e of enemies) e.stunned = 40;
                    } else if (pterodactyl.y < player.y - 15) {
                        // Pterodactyl kills player
                        spawnParticles(player.x, player.y, '#ff2222', 30);
                        lives--;
                        updateHUD();
                        if (lives <= 0) { gameOver = true; return; }
                        player.x = 150;
                        player.y = 300;
                        player.vx = 0;
                        player.vy = 0;
                        pterodactyl.active = false;
                    } else {
                        // Bounce
                        player.vx *= -1;
                        pterodactyl.vx *= -1;
                    }
                }

                // Pterodactyl kills enemies (exceptional)
                for (let i = enemies.length - 1; i >= 0; i--) {
                    const e = enemies[i];
                    if (dist({ x: pterodactyl.x, y: pterodactyl.y }, e) < 28 + e.radius) {
                        spawnParticles(e.x, e.y, '#ff8844', 15);
                        enemies.splice(i, 1);
                    }
                }
            }

            // --- WAVE MANAGEMENT ---
            if (enemies.length === 0 && !pterodactyl.active && enemiesSpawned > 0) {
                waveClearTimer++;
                if (waveClearTimer > 30) {
                    wave++;
                    enemiesPerWave = Math.min(3 + wave * 2, 14);
                    updateHUD();
                    spawnWave();
                    spawnFloatingText(W / 2 - 60, 120, `⚔️ WAVE ${wave}`, '#88ddff');
                    // Bonus for clearing
                    score += 20;
                    updateHUD();
                }
            }

            // --- PARTICLES ---
            for (let i = particles.length - 1; i >= 0; i--) {
                const p = particles[i];
                p.x += p.vx;
                p.y += p.vy;
                p.vy += 0.05;
                p.life--;
                if (p.life <= 0) particles.splice(i, 1);
            }

            // --- FLOATING TEXTS ---
            for (let i = floatingTexts.length - 1; i >= 0; i--) {
                const ft = floatingTexts[i];
                ft.y += ft.vy;
                ft.life--;
                if (ft.life <= 0) floatingTexts.splice(i, 1);
            }

            updateHUD();
        }

        // ----- DRAW -----
        function draw() {
            ctx.clearRect(0, 0, W, H);

            // ---- Background ----
            const grad = ctx.createLinearGradient(0, 0, 0, H);
            grad.addColorStop(0, '#0a0515');
            grad.addColorStop(0.3, '#19103a');
            grad.addColorStop(0.6, '#2d1a4a');
            grad.addColorStop(0.8, '#1f0e2e');
            grad.addColorStop(1, '#0a0512');
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, W, H);

            // Stars
            ctx.fillStyle = 'rgba(255,255,240,0.5)';
            for (let i = 0; i < 80; i++) {
                const sx = (i * 173 + 43) % W;
                const sy = (i * 251 + 17) % (GROUND_Y - 20);
                const sr = 0.5 + (i % 3) * 0.6;
                ctx.beginPath();
                ctx.arc(sx, sy, sr, 0, Math.PI * 2);
                ctx.fill();
            }

            // ---- Platforms ----
            for (let p of PLATFORMS) {
                // Shadow
                ctx.fillStyle = 'rgba(0,0,0,0.4)';
                ctx.fillRect(p.x + 6, p.y + 6, p.w, p.h);
                // Stone
                const gradP = ctx.createLinearGradient(p.x, p.y, p.x, p.y + p.h);
                gradP.addColorStop(0, '#7a8a8a');
                gradP.addColorStop(0.3, '#5a6a6a');
                gradP.addColorStop(1, '#3a4a4a');
                ctx.fillStyle = gradP;
                ctx.shadowColor = 'rgba(0,0,0,0.5)';
                ctx.shadowBlur = 10;
                ctx.fillRect(p.x, p.y, p.w, p.h);
                ctx.shadowBlur = 0;
                // Highlight
                ctx.fillStyle = 'rgba(200,220,220,0.15)';
                ctx.fillRect(p.x + 4, p.y + 2, p.w - 8, 4);
                // Edge cracks
                ctx.strokeStyle = '#2a3a3a';
                ctx.lineWidth = 1;
                for (let i = 0; i < p.w; i += 20) {
                    ctx.beginPath();
                    ctx.moveTo(p.x + i, p.y + 4);
                    ctx.lineTo(p.x + i + 6, p.y + p.h - 4);
                    ctx.stroke();
                }
            }

            // ---- Lava (Ground) ----
            const lavaGrad = ctx.createLinearGradient(0, GROUND_Y, 0, H);
            lavaGrad.addColorStop(0, '#ff4400');
            lavaGrad.addColorStop(0.3, '#cc2200');
            lavaGrad.addColorStop(0.7, '#881100');
            lavaGrad.addColorStop(1, '#440800');
            ctx.fillStyle = lavaGrad;
            ctx.fillRect(0, GROUND_Y, W, H - GROUND_Y);
            // Lava bubbles
            ctx.fillStyle = 'rgba(255,200,80,0.3)';
            for (let i = 0; i < 12; i++) {
                const bx = (i * 67 + frame * 1.2) % W;
                const by = GROUND_Y + 10 + Math.sin(i * 1.5 + frame * 0.05) * 15;
                ctx.beginPath();
                ctx.arc(bx, by, 4 + Math.sin(frame * 0.1 + i) * 2, 0, Math.PI * 2);
                ctx.fill();
            }

            // ---- Troll ----
            if (troll.active || troll.y < GROUND_Y) {
                const ty = Math.min(troll.y, GROUND_Y);
                ctx.shadowColor = 'rgba(255,50,0,0.4)';
                ctx.shadowBlur = 25;
                // Arm
                ctx.fillStyle = '#4a2a1a';
                ctx.fillRect(troll.handX - 12, ty - 60, 24, 60);
                ctx.fillStyle = '#6a3a2a';
                ctx.fillRect(troll.handX - 16, ty - 20, 32, 20);
                // Hand / Fingers
                ctx.fillStyle = '#5a2a1a';
                for (let f = 0; f < 4; f++) {
                    const fx = troll.handX - 14 + f * 10;
                    const fy = ty - 30 + Math.sin(frame * 0.2 + f) * 4;
                    ctx.beginPath();
                    ctx.ellipse(fx, fy, 8, 12, 0.1, 0, Math.PI * 2);
                    ctx.fill();
                }
                // Eye on hand
                ctx.fillStyle = '#ff4444';
                ctx.shadowBlur = 15;
                ctx.beginPath();
                ctx.arc(troll.handX, ty - 45, 6, 0, Math.PI * 2);
                ctx.fill();
                ctx.fillStyle = '#ffff44';
                ctx.beginPath();
                ctx.arc(troll.handX + 2, ty - 46, 2.5, 0, Math.PI * 2);
                ctx.fill();
                ctx.shadowBlur = 0;
            }

            // ---- Eggs ----
            for (let egg of eggs) {
                ctx.shadowColor = 'rgba(255,200,100,0.3)';
                ctx.shadowBlur = 12;
                ctx.fillStyle = '#f5e6b0';
                ctx.beginPath();
                ctx.ellipse(egg.x, egg.y, egg.radius, egg.radius * 1.3, 0, 0, Math.PI * 2);
                ctx.fill();
                ctx.fillStyle = '#d4b87a';
                ctx.beginPath();
                ctx.ellipse(egg.x - 2, egg.y - 3, 3, 4, 0, 0, Math.PI * 2);
                ctx.fill();
                // Cracking if about to hatch
                if (egg.lifetime > egg.maxLifetime * 0.6) {
                    ctx.strokeStyle = '#8a6a3a';
                    ctx.lineWidth = 2;
                    ctx.beginPath();
                    ctx.moveTo(egg.x - 6, egg.y - 4);
                    ctx.lineTo(egg.x - 1, egg.y + 3);
                    ctx.lineTo(egg.x + 5, egg.y - 2);
                    ctx.stroke();
                }
                ctx.shadowBlur = 0;
            }

            // ---- Enemies ----
            for (let e of enemies) {
                const x = e.x,
                    y = e.y;
                const stunned = e.stunned > 0;
                const col = stunned ? '#7788aa' : e.color;

                ctx.shadowColor = stunned ? 'rgba(200,200,255,0.2)' : 'rgba(200,50,50,0.2)';
                ctx.shadowBlur = 10;

                // Body
                ctx.fillStyle = col;
                ctx.beginPath();
                ctx.ellipse(x, y, e.radius, e.radius * 0.7, 0, 0, Math.PI * 2);
                ctx.fill();
                ctx.strokeStyle = stunned ? '#445566' : '#3a1a1a';
                ctx.lineWidth = 1.5;
                ctx.stroke();

                // Wings
                const wingAngle = Math.sin(e.flapTimer * 0.3 + e.x) * 0.5 + 0.4;
                ctx.fillStyle = stunned ? '#556677' : col;
                ctx.beginPath();
                ctx.ellipse(x - 10, y - 4 + wingAngle * 7, 11, 5, -0.3 + wingAngle * 0.4, 0, Math.PI * 2);
                ctx.fill();
                ctx.beginPath();
                ctx.ellipse(x + 10, y - 4 + wingAngle * 7, 11, 5, 0.3 - wingAngle * 0.4, 0, Math.PI * 2);
                ctx.fill();

                // Beak
                ctx.fillStyle = '#ddaa33';
                ctx.beginPath();
                ctx.moveTo(x + 12, y - 2);
                ctx.lineTo(x + 20, y + 1);
                ctx.lineTo(x + 12, y + 5);
                ctx.fill();

                // Eye
                ctx.fillStyle = '#ffdd44';
                ctx.beginPath();
                ctx.arc(x + 7, y - 4, 4, 0, Math.PI * 2);
                ctx.fill();
                ctx.fillStyle = '#1a1a1a';
                ctx.beginPath();
                ctx.arc(x + 9, y - 5, 2, 0, Math.PI * 2);
                ctx.fill();

                // Type indicator (Shadow Lords have a glow)
                if (e.type === 'shadow') {
                    ctx.shadowColor = 'rgba(68,136,221,0.4)';
                    ctx.shadowBlur = 20;
                    ctx.strokeStyle = 'rgba(68,136,221,0.3)';
                    ctx.lineWidth = 2;
                    ctx.beginPath();
                    ctx.arc(x, y, e.radius + 4, 0, Math.PI * 2);
                    ctx.stroke();
                }

                // Stun stars
                if (stunned) {
                    ctx.fillStyle = 'rgba(255,255,200,0.6)';
                    ctx.font = '18px Arial';
                    ctx.textAlign = 'center';
                    ctx.fillText('💫', x, y - 28);
                }
                ctx.shadowBlur = 0;
            }

            // ---- Pterodactyl ----
            if (pterodactyl.active) {
                const px = pterodactyl.x,
                    py = pterodactyl.y;
                ctx.shadowColor = 'rgba(255,100,50,0.5)';
                ctx.shadowBlur = 30;
                // Body
                ctx.fillStyle = '#5a3a2a';
                ctx.beginPath();
                ctx.ellipse(px, py, 26, 14, 0, 0, Math.PI * 2);
                ctx.fill();
                // Wings (giant)
                ctx.fillStyle = '#3a2a1a';
                const pWing = Math.sin(frame * 0.2) * 20 + 25;
                ctx.beginPath();
                ctx.moveTo(px - 20, py - 4);
                ctx.lineTo(px - 50, py - 8 - pWing);
                ctx.lineTo(px - 20, py + 2);
                ctx.fill();
                ctx.beginPath();
                ctx.moveTo(px + 20, py - 4);
                ctx.lineTo(px + 50, py - 8 - pWing);
                ctx.lineTo(px + 20, py + 2);
                ctx.fill();
                // Head & Beak
                ctx.fillStyle = '#4a2a1a';
                ctx.beginPath();
                ctx.ellipse(px + 30, py - 4, 10, 8, 0, 0, Math.PI * 2);
                ctx.fill();
                ctx.fillStyle = '#cc8833';
                ctx.beginPath();
                ctx.moveTo(px + 38, py - 6);
                ctx.lineTo(px + 54, py - 2);
                ctx.lineTo(px + 38, py + 2);
                ctx.fill();
                // Eye (angry red)
                ctx.fillStyle = '#ff3333';
                ctx.shadowBlur = 15;
                ctx.beginPath();
                ctx.arc(px + 32, py - 8, 5, 0, Math.PI * 2);
                ctx.fill();
                ctx.fillStyle = '#ffff44';
                ctx.beginPath();
                ctx.arc(px + 34, py - 9, 2, 0, Math.PI * 2);
                ctx.fill();
                ctx.shadowBlur = 0;
            }

            // ---- Player ----
            const px = player.x,
                py = player.y;
            ctx.shadowColor = 'rgba(255,200,100,0.4)';
            ctx.shadowBlur = 20;

            // Ostrich body
            ctx.fillStyle = '#4a7a9a';
            ctx.beginPath();
            ctx.ellipse(px, py, PLAYER_RADIUS, PLAYER_RADIUS * 0.8, 0, 0, Math.PI * 2);
            ctx.fill();
            ctx.strokeStyle = '#2a4a6a';
            ctx.lineWidth = 2;
            ctx.stroke();

            // Neck & Head
            ctx.fillStyle = '#5a8aaa';
            ctx.beginPath();
            ctx.ellipse(px + 14, py - 12, 8, 10, 0.2, 0, Math.PI * 2);
            ctx.fill();
            // Beak
            ctx.fillStyle = '#f5c842';
            ctx.beginPath();
            ctx.moveTo(px + 22, py - 16);
            ctx.lineTo(px + 32, py - 14);
            ctx.lineTo(px + 22, py - 10);
            ctx.fill();
            // Eye
            ctx.fillStyle = 'white';
            ctx.beginPath();
            ctx.arc(px + 18, py - 16, 5, 0, Math.PI * 2);
            ctx.fill();
            ctx.fillStyle = '#1a2a3a';
            ctx.beginPath();
            ctx.arc(px + 20, py - 17, 2.5, 0, Math.PI * 2);
            ctx.fill();

            // Helmet & Plume
            ctx.fillStyle = '#8a8a8a';
            ctx.beginPath();
            ctx.ellipse(px + 12, py - 20, 10, 6, 0.1, 0, Math.PI * 2);
            ctx.fill();
            ctx.fillStyle = '#aaaaaa';
            ctx.fillRect(px + 8, py - 26, 4, 8);
            ctx.fillStyle = '#cc3333';
            ctx.beginPath();
            ctx.moveTo(px + 12, py - 26);
            ctx.lineTo(px + 6, py - 40);
            ctx.lineTo(px + 18, py - 36);
            ctx.fill();

            // Lance
            ctx.strokeStyle = '#c8a86a';
            ctx.lineWidth = 4;
            ctx.beginPath();
            ctx.moveTo(px + 8, py - 4);
            ctx.lineTo(px + 44, py - 18);
            ctx.stroke();
            ctx.fillStyle = '#dddddd';
            ctx.beginPath();
            ctx.arc(px + 46, py - 19, 4, 0, Math.PI * 2);
            ctx.fill();

            // Wings (flapping)
            const flapAnim = (flapping || keys.flap) ? 0.9 : 0.2;
            ctx.fillStyle = '#3a6a8a';
            ctx.beginPath();
            ctx.ellipse(px - 10, py - 6 + flapAnim * 8, 14, 6, -0.4 + flapAnim * 0.6, 0, Math.PI * 2);
            ctx.fill();
            ctx.beginPath();
            ctx.ellipse(px + 6, py - 10 + flapAnim * 6, 10, 5, 0.2 - flapAnim * 0.4, 0, Math.PI * 2);
            ctx.fill();
            ctx.shadowBlur = 0;

            // ---- Particles ----
            for (let p of particles) {
                const alpha = p.life / p.maxLife;
                ctx.globalAlpha = alpha;
                ctx.fillStyle = p.color;
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.radius * alpha, 0, Math.PI * 2);
                ctx.fill();
            }
            ctx.globalAlpha = 1;

            // ---- Floating Texts ----
            for (let ft of floatingTexts) {
                const alpha = ft.life / 50;
                ctx.globalAlpha = alpha;
                ctx.fillStyle = ft.color;
                ctx.font = 'bold 22px "Courier New", monospace';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.shadowColor = 'rgba(0,0,0,0.6)';
                ctx.shadowBlur = 10;
                ctx.fillText(ft.text, ft.x, ft.y);
                ctx.shadowBlur = 0;
            }
            ctx.globalAlpha = 1;

            // ---- Game Over ----
            if (gameOver) {
                ctx.fillStyle = 'rgba(0,0,0,0.75)';
                ctx.fillRect(0, 0, W, H);
                ctx.fillStyle = '#f0c040';
                ctx.font = 'bold 56px "Courier New", monospace';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.shadowColor = 'rgba(255,200,0,0.4)';
                ctx.shadowBlur = 40;
                ctx.fillText('☠️ GAME OVER', W / 2, H / 2 - 40);
                ctx.font = '24px "Courier New", monospace';
                ctx.fillStyle = '#ddccaa';
                ctx.fillText('Tap / Space to Restart', W / 2, H / 2 + 50);
                ctx.shadowBlur = 0;
            }

            // ---- HUD on canvas ----
            ctx.font = 'bold 16px "Courier New", monospace';
            ctx.fillStyle = 'rgba(255,240,200,0.5)';
            ctx.textAlign = 'left';
            ctx.textBaseline = 'top';
            ctx.fillText(`🐦 ${enemies.length} left`, 14, 12);
            if (pterodactyl.active) {
                ctx.fillStyle = '#ff6644';
                ctx.fillText('🦅 DANGER!', 14, 34);
            }
        }

        // ----- GAME LOOP -----
        function gameLoop() {
            update();
            draw();
            requestAnimationFrame(gameLoop);
        }

        // Start
        gameStarted = true;
        resetGame();
        gameLoop();
    })();
</script>
</body>
